mean(abs(mean_measures$tarsus_length_mm.1 - mean_measures$tarsus_length_mm), na.rm = TRUE),
mean(abs(mean_measures$wing_length_mm.1 - mean_measures$wing_length_mm), na.rm = TRUE),
mean(abs(mean_measures$body_length_mm.1 - mean_measures$body_length_mm), na.rm = TRUE)
)
)
