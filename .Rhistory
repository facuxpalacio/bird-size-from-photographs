run_all_bias <- function(museum){
species_list <- list(
passer    = subset(museum, bird_species == "Passer_domesticus"),
milvago   = subset(museum, bird_species == "Milvago_chimango"),
turdus    = subset(museum, bird_species == "Turdus_rufiventris"),
colaptes  = subset(museum, bird_species == "Colaptes_campestris")
)
traits <- c("bill_length_mm",
"wing_length_mm",
"tarsus_length_mm",
"body_length_mm")
out <- list()
k <- 1
for(sp in names(species_list)){
df <- species_list[[sp]]
for(tr in traits){
cat("Running:", sp, "-", tr, "\n")
out[[k]] <- run_bias(df, tr, sp)
k <- k + 1
}
}
bind_rows(out)
}
names(museum_uncorrected)
# Pinhole camera model
prepare_museum_data <- function(correct = FALSE){
museum <- read.table(here("data", "museum experiment.txt"), header = TRUE)
true_values <- read.table(here("data", "museum experiment true values.txt"), header = TRUE)
# Pinhole camera model
museum$bill_length_mm <-
museum$bill_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$wing_length_mm <-
museum$wing_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$tarsus_length_mm <-
museum$tarsus_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$body_length_mm <-
museum$body_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
# Optional cosine correction
if(correct){
museum$bill_length_mm <-
museum$bill_length_mm /
cos(museum$angle_degrees*pi/180)
museum$wing_length_mm <-
museum$wing_length_mm /
cos(museum$angle_degrees*pi/180)
museum$tarsus_length_mm <-
museum$tarsus_length_mm /
cos(museum$angle_degrees*pi/180)
museum$body_length_mm <-
museum$body_length_mm /
cos(museum$angle_degrees*pi/180)
}
# Replace true measurements
idx <- museum$measurement == "true"
museum$bill_length_mm[idx] <-
true_values$bill_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$wing_length_mm[idx] <-
true_values$wing_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$tarsus_length_mm[idx] <-
true_values$tarsus_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$body_length_mm[idx] <-
true_values$body_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$dist_bird_m <- museum$dist_bird_mm/1000 # in meters
return(museum)
}
