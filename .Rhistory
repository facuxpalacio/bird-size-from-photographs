results_uncorrected <- run_all_bias(museum_uncorrected)
run_all_bias <- function(museum){
species_list <- list(
passer    = subset(museum, bird_species == "Passer_domesticus"),
milvago   = subset(museum, bird_species == "Milvago_chimango"),
turdus    = subset(museum, bird_species == "Turdus_rufiventris"),
colaptes  = subset(museum, bird_species == "Colaptes_campestris")
)
traits <- c("bill_length_mm",
"wing_length_mm",
"tarsus_length_mm",
"body_length_mm")
out <- list()
k <- 1
for(sp in names(species_list)){
df <- species_list[[sp]]
for(tr in traits){
cat("Running:", sp, "-", tr, "\n")
out[[k]] <- run_bias(df, tr, sp)
k <- k + 1
}
}
bind_rows(out)
}
names(museum_uncorrected)
# Pinhole camera model
prepare_museum_data <- function(correct = FALSE){
museum <- read.table(here("data", "museum experiment.txt"), header = TRUE)
true_values <- read.table(here("data", "museum experiment true values.txt"), header = TRUE)
# Pinhole camera model
museum$bill_length_mm <-
museum$bill_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$wing_length_mm <-
museum$wing_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$tarsus_length_mm <-
museum$tarsus_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
museum$body_length_mm <-
museum$body_length_sensor * museum$dist_bird_mm / museum$focal_dist_mm
# Optional cosine correction
if(correct){
museum$bill_length_mm <-
museum$bill_length_mm /
cos(museum$angle_degrees*pi/180)
museum$wing_length_mm <-
museum$wing_length_mm /
cos(museum$angle_degrees*pi/180)
museum$tarsus_length_mm <-
museum$tarsus_length_mm /
cos(museum$angle_degrees*pi/180)
museum$body_length_mm <-
museum$body_length_mm /
cos(museum$angle_degrees*pi/180)
}
# Replace true measurements
idx <- museum$measurement == "true"
museum$bill_length_mm[idx] <-
true_values$bill_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$wing_length_mm[idx] <-
true_values$wing_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$tarsus_length_mm[idx] <-
true_values$tarsus_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$body_length_mm[idx] <-
true_values$body_length_mm[
match(museum$bird_species[idx], true_values$bird_species)
]
museum$dist_bird_m <- museum$dist_bird_mm/1000 # in meters
return(museum)
}
estimated <- subset(museum, measurement == "scaled_photograph")
true <- subset(museum, measurement == "true")
estimated$bird_species <- as.factor(estimated$bird_species)
true$bird_species <- as.factor(true$bird_species)
# Subset species
run_all_bias <- function(museum){
species_list <- list(
passer    = subset(museum, bird_species == "Passer_domesticus"),
milvago   = subset(museum, bird_species == "Milvago_chimango"),
turdus    = subset(museum, bird_species == "Turdus_rufiventris"),
colaptes  = subset(museum, bird_species == "Colaptes_campestris")
)
traits <- c("bill_length_mm",
"wing_length_mm",
"tarsus_length_mm",
"body_length_mm")
purrr::imap_dfr(species_list, function(df, sp){
purrr::map_dfr(traits, function(tr){
run_bias(df, tr, sp)
})
})
}
# Function to estimate bias (obs = trait, true = true value, est = data frame with covariates)
bias <- function(obs_values, true, est){
output <- vector("list", 7)
obs <- est[[obs_values]]
# Absolute bias (used for models)
bias_trait <- 100 * abs((obs - true) / true)
bias_trait[!is.finite(bias_trait)] <- NA
# Signed bias (used only for descriptive summaries)
bias_signed <- 100*((obs - true)/true)
bias_signed[!is.finite(bias_signed)] <- NA
est$bias_trait  <- bias_trait
est$bias_signed <- bias_signed
# General summary
output[[1]] <- data.frame(
mean_bias = round(mean(bias_trait, na.rm = TRUE), 2),
sd_bias   = round(sd(bias_trait, na.rm = TRUE), 2)
)
# Filter complete cases
est_model <- est[complete.cases(est[, c("bias_trait",
"dist_bird_m",
"angle_degrees",
"angle_height")]), ]
# GLS model
bias_model <- nlme::gls(
bias_trait ~ dist_bird_m + angle_degrees + angle_height,
data = est_model,
weights = varPower(form = ~ angle_degrees + 1e-6)
)
# Store the model
output[[2]] <- bias_model
# Pseudo-R2
output[[3]] <- 1 - (
var(resid(bias_model, type = "normalized")) /
var(est_model$bias_trait, na.rm = TRUE)
)
# Summary per angle
angle <- sort(unique(est$angle_degrees))
angle_df <- matrix(NA, nrow = length(angle), ncol = 2)
for(i in seq_along(angle)){
angle_subset <- subset(est, angle_degrees == angle[i])
bias_angle <- angle_subset$bias_signed
angle_df[i, 1] <- round(mean(bias_angle, na.rm = TRUE), 2)
angle_df[i, 2] <- round(sd(bias_angle, na.rm = TRUE), 2)
}
output[[4]] <- data.frame(
angle = angle,
mean_bias = angle_df[,1],
sd_bias = angle_df[,2]
)
output[[5]] <- cor(est[, c("dist_bird_m",
"angle_degrees",
"angle_height")],
use = "complete.obs")
output[[6]] <- cor(est_model[, c("dist_bird_m",
"angle_degrees",
"angle_height")],
use = "complete.obs")
# VIF
lm_vif <- lm(bias_trait ~ dist_bird_m + angle_degrees + angle_height,
data = est_model)
output[[7]] <- car::vif(lm_vif)
invisible({
plot(est$angle_degrees, bias_trait,
xlab = "Angle (degrees)",
ylab = "Bias (%)")
abline(lm(bias_trait ~ angle_degrees, data = est),
col = "red")
plot(fitted(bias_model),
resid(bias_model, type = "normalized"),
xlab = "Fitted values",
ylab = "Normalized residuals",
main = "Residuals vs Fitted")
abline(h = 0, lty = 2, col = "blue")
})
return(output)
}
# Wrapper to run bias
run_bias <- function(df, trait, species_name){
estimated <- df[df$measurement != "true", ]
true_val <- df[df$measurement == "true", trait]
res <- bias(est = estimated,
obs_values = trait,
true = true_val)
angle_summary <- res[[4]]
angle_summary$species <- species_name
angle_summary$trait <- trait
return(angle_summary)
}
# Loop for every species-trait combination
results <- purrr::imap_dfr(species_list, function(df, sp){
purrr::map_dfr(traits,
function(tr){
run_bias(df, tr, sp)
}
)
})
