)
results_final <-
left_join(results_uncorrected,
results_corrected,
by = c("species","trait","angle"),
suffix = c("_uncorrected","_corrected")) |>
rename(
Species = species,
Trait = trait,
Angle = angle,
Mean_bias_uncorrected = mean_bias_uncorrected,
SD_uncorrected = sd_bias_uncorrected,
Mean_bias_corrected = mean_bias_corrected,
SD_corrected = sd_bias_corrected
)
results_corrected <- run_all_bias(
prepare_museum_data(correct = TRUE)
)
results_final <-
left_join(results_uncorrected,
results_corrected,
by = c("species","trait","angle"),
suffix = c("_uncorrected","_corrected")) |>
rename(
Species = species,
Trait = trait,
Angle = angle,
Mean_bias_uncorrected = mean_bias_uncorrected,
SD_uncorrected = sd_bias_uncorrected,
Mean_bias_corrected = mean_bias_corrected,
SD_corrected = sd_bias_corrected
)
results_final
