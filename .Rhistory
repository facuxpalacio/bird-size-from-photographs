library(ggplot2) # for plotting
library(dplyr) # data handling
library(tidyr) # data handling
library(ggrepel) # plotting layout
library(car) # anova
library(FD) # functional diversity
library(funspace) # functional trait space
library(nlme) # generalized least squares
library(here) # path reproducibility
# Field measures
field_measures <- read.table(here("data", "field measurements.txt", head = T))
# Field measures
field_measures <- read.table(here("data", "field measurements.txt"), head = T))
# Field measures
field_measures <- read.table(here("data", "field measurements.txt"), head = T)
sp <- unique(field_measures$Species)
# AVONET database
avo <- read.delim(here("data", "AVONET_birdtree.txt"))
avo.sp <- avo[avo$Species %in% sp, ]
# Means per species
means.avo <- avo.sp %>% group_by(Species) %>%
summarise(Beak.Length_Culmen = mean(Beak.Length_Culmen, na.rm = T),
Tarsus.Length = mean(Tarsus.Length, na.rm = T),
Wing.Length = mean(Wing.Length, na.rm = T))
means.field <- field_measures %>% group_by(Species) %>%
summarise(Beak.Length_Culmen = mean(corr_bill_length_mm, na.rm = T),
Tarsus.Length = mean(corr_tarsus_length_mm, na.rm = T),
Wing.Length = mean(corr_wing_length_mm, na.rm = T))
means_measures <- data.frame(means.avo, means.field)
# Plots between field and AVONET measurements
ggplot(data = means_measures, aes(x = Beak.Length_Culmen,
y = Beak.Length_Culmen.1)) +
geom_point() + xlab("Mean bill length (AVONET) (mm)") +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
ylab("Mean bill length (photographs) (mm)")
ggplot(data = means_measures, aes(x = Tarsus.Length,
y = Tarsus.Length.1)) +
geom_point() +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
xlab("Mean tarsus length (AVONET) (mm)") +
ylab("Mean tarsus length (photographs) (mm)")
ggplot(data = means_measures, aes(x = Wing.Length,
y = Wing.Length.1)) +
geom_point() + xlab("Mean wing length (AVONET) (mm)") +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
ylab("Mean wing length (photographs) (mm)") +
ylim(0,100)
# Correlations between field and AVONET measurements
cor(means_measures$Beak.Length_Culmen,
means_measures$Beak.Length_Culmen.1, use = "complete.obs",
method = "spearman")
cor(means_measures$Tarsus.Length,
means_measures$Tarsus.Length.1, use = "complete.obs",
method = "spearman")
cor(means_measures$Wing.Length,
means_measures$Wing.Length.1, use = "complete.obs",
method = "spearman")
# Deviations from the 1:1 line
mBill <- lm(Beak.Length_Culmen.1 ~ Beak.Length_Culmen,
data = means_measures)
linearHypothesis(mBill, c("(Intercept) = 0",
"Beak.Length_Culmen = 1"))
mTarsus <- lm(Tarsus.Length.1 ~ Tarsus.Length,
data = means_measures)
linearHypothesis(mTarsus, c("(Intercept) = 0",
"Tarsus.Length = 1"))
mWing <- lm(Wing.Length.1 ~ Wing.Length,
data = means_measures)
linearHypothesis(mWing, c("(Intercept) = 0",
"Wing.Length = 1"))
museum <- read.table(here("data", "mounted specimens.txt"), head = T)
means.museum <- museum %>% group_by(species) %>%
summarise(beak_length_mm = mean(bill_length_mm, na.rm = T),
tarsus_length_mm = mean(tarsus_length_mm, na.rm = T),
wing_length_mm = 10*mean(wing_length_cm, na.rm = T),
body_length_mm = 10*mean(body_length_cm, na.rm = T))
sp <- unique(museum$species)
length(sp) # n species
field_measures <- read.table(here("data", "field measurements.txt"), head = T)
field_measures$survey_number <- as.factor(field_measures$survey_number)
rownames(field_measures) <- make.names(field_measures$Species, unique = T)
field_measures.sp <- field_measures[field_measures$Species %in% sp, ]
means.field <- field_measures.sp %>% group_by(Species) %>%
summarise(beak_length_mm = mean(corr_bill_length_mm, na.rm = T),
tarsus_length_mm = mean(corr_tarsus_length_mm, na.rm = T),
wing_length_mm = mean(corr_wing_length_mm, na.rm = T),
body_length_mm = mean(corr_body_length_mm, na.rm = T))
mean_measures <- data.frame(means.museum, means.field)
ggplot(data = mean_measures, aes(x = beak_length_mm,
y = beak_length_mm.1)) +
geom_point() + xlab("Mean bill length (museum) (mm)") +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
ylab("Mean bill length (photographs) (mm)")
ggplot(data = mean_measures, aes(x = tarsus_length_mm,
y = tarsus_length_mm.1)) +
geom_point() +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
xlab("Mean tarsus length (museum) (mm)") +
ylab("Mean tarsus length (photographs) (mm)")
ggplot(data = mean_measures, aes(x = wing_length_mm,
y = wing_length_mm.1)) +
geom_point() + xlab("Mean wing length (museum) (mm)") +
geom_abline(slope = 1, intercept = 0,
color = "red", linetype = "dashed") +
ylab("Mean wing length (photographs) (mm)") +
ylim(0,100)
# Correlations field vs museum measures
cor(mean_measures$beak_length_mm,
mean_measures$beak_length_mm.1, use = "complete.obs",
method = "spearman")
cor(mean_measures$tarsus_length_mm,
mean_measures$tarsus_length_mm.1, use = "complete.obs",
method = "spearman")
cor(mean_measures$wing_length_mm,
mean_measures$wing_length_mm.1, use = "complete.obs",
method = "spearman")
cor(mean_measures$body_length_mm,
mean_measures$body_length_mm.1, use = "complete.obs",
method = "spearman")
# Deviations from the 1:1 line
mBill <- lm(beak_length_mm.1 ~ beak_length_mm,
data = mean_measures)
linearHypothesis(mBill, c("(Intercept) = 0",
"beak_length_mm = 1"))
mTarsus <- lm(tarsus_length_mm.1 ~ tarsus_length_mm,
data = mean_measures)
linearHypothesis(mTarsus, c("(Intercept) = 0",
"tarsus_length_mm = 1"))
mWing <- lm(wing_length_mm.1 ~ wing_length_mm,
data = mean_measures)
linearHypothesis(mWing, c("(Intercept) = 0",
"wing_length_mm = 1"))
mBody <- lm(body_length_mm.1 ~ body_length_mm,
data = medias_medidas)
