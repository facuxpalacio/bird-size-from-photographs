FDiv_obs # Functional divergence
# Sample sizes per species
sp <- sp_means$Species
museum <- read.table(here("data", "mounted specimens.txt"), head = T)
museum.sp <- museum[museum$species %in% sp, ]
museum.sp$Species <- as.factor(museum.sp$species)
sample_sizes <- table(museum.sp$Species)
museum.sp <- museum.sp[,-1]
# Bootstrapping from the museum specimens
set.seed(664)
nsim <- 500 # Number of simulated assemblages
FD <- matrix(NA, nrow = nsim, ncol = 2)
for(i in 1:nsim){
# Sample the same species from the museum specimens as those observed in the assemblage
sample_list <- vector("list", length(sample_sizes))
for(j in 1:length(sample_sizes)){
sp_museum <- subset(museum.sp, Species == names(sample_sizes[j]))
sample_list[[j]] <- sp_museum[sample(1:nrow(sp_museum),
size = sample_sizes[j], replace = T), ]
}
# Combine sampled species into a single dataframe
rand_traits <- do.call("rbind", sample_list)
rownames(rand_traits) <- make.names(rand_traits$Species, unique = T)
sp_means <- rand_traits %>% group_by(Species) %>%
summarise(xBeak.Length_Culmen = mean(bill_length_mm, na.rm = T),
xWing.Length = 10*mean(wing_length_cm, na.rm = T),
xTarsus.Length = mean(tarsus_length_mm, na.rm = T),
xBody.Length = 10*mean(body_length_cm, na.rm = T))
# Compute FD and store the results
pca <- princomp(sp_means[,-1], cor = TRUE)
trait_space <- funspace(x = pca,
PCs = c(1,2), n_divisions = 300)
FD[i, 1] <- trait_space$FD$global$FRich
FD[i, 2] <- trait_space$FD$global$FDiv
}
