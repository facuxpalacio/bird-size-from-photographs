# Functional diversity from field photographs
sp_means <- field_measures %>% group_by(Species) %>%
summarise(beak_length_mm = mean(corr_bill_length_mm, na.rm = T),
wing_length_mm = mean(corr_wing_length_mm, na.rm = T),
tarsus_length_mm = mean(corr_tarsus_length_mm, na.rm = T),
body_length_mm = mean(corr_body_length_mm, na.rm = T))
# Observed FD
trait_matrix <- na.omit(scale(sp_means[,-1]))
x <- as.matrix(dist(trait_matrix))
pca <- princomp(trait_matrix,cor=T)
trait_space_obs <- funspace(x = pca, PCs = c(1,2), n_divisions = 300)
plot(x = trait_space_obs,
quant.plot = F, # Plot quantile lines
globalContour = F,
pnt = T, pnt.cex = 1.5, pnt.col = rgb(0, 0, 0, alpha = 0.2))
FRic_obs <- trait_space_obs$FD$global$FRich
FDiv_obs <-trait_space_obs$FD$global$FDiv
FRic_obs # Functional richness
FDiv_obs # Functional divergence
