## Check model results
run_bias_gls <- function(df, trait, species_name){
tryCatch({
estimated <- df[df$medida != "real", ]
true_val <- df[df$medida == "real", trait]
res <- bias(est = estimated,
obs_values = trait,
true = true_val)
tab <- summary(res[[2]])$tTable
data.frame(
Species = species_name,
Trait = trait,
Parameter = rownames(tab),
Estimate = tab[, "Value"],
SE = tab[, "Std.Error"],
t = tab[, "t-value"],
p = tab[, "p-value"],
R2 = res[[3]]
)
}, error = function(e){
message("FAILED: ", species_name, " - ", trait)
message(e$message)
NULL
})
}
