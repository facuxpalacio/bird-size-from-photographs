field_measures <- read.table(here("data", "field measurements.txt"), head = T)
field_measures$survey_number <- as.factor(field_measures$survey_number)
rownames(field_measures) <- make.names(field_measures$Species, unique = T)
field_measures.sp <- field_measures[field_measures$Species %in% sp, ]
means.field <- field_measures.sp %>% group_by(Species) %>%
summarise(beak_length_mm = mean(corr_bill_length_mm, na.rm = T),
tarsus_length_mm = mean(corr_tarsus_length_mm, na.rm = T),
wing_length_mm = mean(corr_wing_length_mm, na.rm = T),
body_length_mm = mean(corr_body_length_mm, na.rm = T))
mean_measures <- data.frame(means.museum, means.field)
error_stats <- data.frame(
Trait = c("Bill length", "Tarsus length", "Wing length", "Body length"),
RMSE = c(
sqrt(mean((mean_measures$beak_length_mm.1 - mean_measures$beak_length_mm)^2, na.rm = TRUE)),
sqrt(mean((mean_measures$tarsus_length_mm.1 - mean_measures$tarsus_length_mm)^2, na.rm = TRUE)),
sqrt(mean((mean_measures$wing_length_mm.1 - mean_measures$wing_length_mm)^2, na.rm = TRUE)),
sqrt(mean((mean_measures$body_length_mm.1 - mean_measures$body_length_mm)^2, na.rm = TRUE))
),
MAE = c(
mean(abs(mean_measures$beak_length_mm.1 - mean_measures$beak_length_mm), na.rm = TRUE),
mean(abs(mean_measures$tarsus_length_mm.1 - mean_measures$tarsus_length_mm), na.rm = TRUE),
mean(abs(mean_measures$wing_length_mm.1 - mean_measures$wing_length_mm), na.rm = TRUE),
mean(abs(mean_measures$body_length_mm.1 - mean_measures$body_length_mm), na.rm = TRUE)
)
)
